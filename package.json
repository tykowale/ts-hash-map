{
  "name": "@tykowale/ts-hash-map",
  "version": "1.2.0",
  "description": "TS Hash Map",
  "keywords": [
    "hash",
    "hashmap",
    "map",
    "structural-equality",
    "typescript"
  ],
  "homepage": "https://github.com/tykowale/ts-hash-map#readme",
  "bugs": {
    "url": "https://github.com/tykowale/ts-hash-map/issues"
  },
  "license": "MIT",
  "author": "Ty Kowalewski<tykowale@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tykowale/ts-hash-map.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:package": "tsc -p test/consumer && tsc -p test/consumer/tsconfig.legacy-lib.json && node test/consumer/smoke.mjs && node test/consumer/smoke.cjs",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:package",
    "benchmark": "tsx bench/hash-map.bench.ts",
    "object-benchmark": "tsx bench/object.bench.ts",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-json-stable-stringify": "^2.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
